{
  "name": "crumple-landing",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "^24.22.1"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "rsbuild dev --port 3000",
    "generate-routes": "rsbuild build",
    "build": "rsbuild build",
    "start": "srvx --prod -s ../client dist/server/index.js",
    "preview": "rsbuild preview",
    "format": "bun fmt --no-script --check .",
    "format:write": "bun fmt --no-script --write .",
    "lint": "oxlint -c .oxlintrc.json",
    "typecheck": "bun check --no-script",
    "knip": "knip --no-config-hints",
    "test": "bun test",
    "check": "bun run format && bun run lint && bun run typecheck && bun run knip && bun run test"
  },
  "dependencies": {
    "@fontsource/old-standard-tt": "^5.3.0",
    "@fontsource/reenie-beanie": "^5.3.0",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "cannon-es": "^0.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "srvx": "^0.12.7",
    "tailwindcss": "^4.1.18",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "@rsbuild/core": "^2.1.13",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "knip": "6.44.2",
    "oxlint": "1.93.0",
    "oxlint-plugin-react-doctor": "0.9.22",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  }
}
